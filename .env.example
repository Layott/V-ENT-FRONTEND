# Copy to .env.local and fill in. NEVER commit a file containing real values.
# .env and src/app/.env were tracked in this repo until 2026-08-17; every secret
# that was in them must be treated as compromised and rotated.

# This deployment's own public URL. NextAuth derives every redirect from it.
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Django API base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Social login (leave blank to disable the buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production media host for next/image (e.g. api.v-ent.co). Dev can leave blank.
NEXT_PUBLIC_MEDIA_HOST=
