# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
*.env.local
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local run artefacts
.dev-server.log
.dev-server.err
scripts/audit-out/
scripts/mobile-shots/

# Python bytecode from the scripts/ checkers.
__pycache__/
*.pyc
.next-dev
.next-dev-*

# A browser profile of its own for scripts/walk-console.mjs, so a walk does not
# share cookies with whatever else is signed in on this machine.
# Every walker Chrome profile (each holds a signed-in session) and its output.
.walk-profile*/
.walk-overlays/

# Keys and service credentials never enter the repo (owner rule R62)
*.key
*.p12
*.pfx
*service-account*.json
*credentials*.json
